# =============================================================================
# Nginx Secure - Red Hat Hummingbird Edition
# =============================================================================

ARG BUILDER_IMAGE=nexus-registry.project1.kbstar-st.com/enterprise/framework/base/core-runtime:latest-builder
ARG RUNTIME_IMAGE=nexus-registry.project1.kbstar-st.com/enterprise/framework/base/core-runtime:latest

# -------------------------------
# Stage 1: Build/install dependencies
# -------------------------------
FROM ${BUILDER_IMAGE} AS builder

USER root

# CORPORATE CA from a secret if building on CACI Network build with:
#   docker buildx build -t image-name:latest -f .\Dockerfile.image . --secret id=corp-ca,src=.\corp-ca.cer
RUN --mount=type=secret,id=corp-ca \
    if [ -f /run/secrets/corp-ca ]; then \
        cp /run/secrets/corp-ca /usr/share/pki/ca-trust-source/anchors/corp.crt && \
        update-ca-trust; \
    fi


WORKDIR /
COPY nginx/docker-entrypoint.sh /docker-entrypoint.sh
COPY nginx/docker-entrypoint.d/ /docker-entrypoint.d/
COPY nginx/nginx.conf /etc/nginx/

# === Install runtime dependencies ===
RUN groupadd -g 1001 -r nginx && \
  useradd -u 1001 -r -g nginx -d /data/db -s /sbin/nologin nginx && \
  dnf install -y --setopt=install_weak_deps=False \
    nginx \
    awk \
    sed \
    find \
    envsubst && \
  mkdir -p /docker-entrypoint.d/ && \
  mkdir -p /etc/nginx/templates && \
  mkdir -p /var/cache/nginx && \
  mkdir -p /var/log/nginx && \
  cp /etc/nginx/mime.types.default /etc/nginx/mime.types && \
  chown -R nginx:nginx /etc/nginx && \
  chown -R nginx:nginx /var/log/nginx && \
  chown -R nginx:nginx /var/lib/nginx && \
  chown -R nginx:nginx /var/cache/nginx && \
  chown -R nginx:nginx /usr/share/nginx && \
  chown -R nginx:nginx /docker-entrypoint.d && \
  chmod o-w /etc/nginx/nginx.conf && \
  chmod o-w /docker-entrypoint.d/* && \
  chmod o-w /docker-entrypoint.sh

# === Collect all required libraries in one place ===
RUN mkdir -p /tmp/required-libs && \
    copy_safe_libs() { \
      ldd "$1" 2>/dev/null | grep -o '/lib[^ ]*\.so[^ ]*' | while read lib; do \
        # Skip core glibc, ld, and problematic systemd versions
        if echo "$lib" | grep -qE '(/lib64/)(libc\.so|ld-linux|libm\.so|libpthread|libdl|libgcc_s|libstdc\+\+|libsystemd|libpcre2)'; then \
          continue; \
        fi; \
        cp -a -- "$lib"* /tmp/required-libs/ 2>/dev/null || true; \
      done; \
    }; \
    for bin in /bin/nginx /bin/awk; do \
      [ -f "$bin" ] && copy_safe_libs "$bin"; \
    done && \
    # Safe extras (exclude systemd)
    for lib in libzstd liblz4 libxml2 libicu libevent libpam libaudit libcap-ng libselinux \
               libz libcrypt libsasl2 libldap liblber libpq libreadline libtinfo; do \
      cp -a /usr/lib64/${lib}*.so* /tmp/required-libs/ 2>/dev/null || true; \
    done


# -------------------------------
# Stage 2: Runtime image
# -------------------------------
FROM ${RUNTIME_IMAGE}

LABEL org.opencontainers.image.title="Nginx (Red Hat Hummingbird edition)" \
  org.opencontainers.image.description="Secure Nginx runtime using Red Hat Hummingbird" \
  classification="UNCLASSIFIED"

# === Copy the application binaries, libaries, and support ===
COPY --from=builder /bin/nginx /bin/nginx
COPY --from=builder /etc/nginx/ /etc/nginx/
COPY --from=builder /usr/share/nginx /usr/share/nginx
COPY --from=builder /var/cache/nginx /var/cache/nginx
COPY --from=builder /var/log/nginx /var/log/nginx
COPY --from=builder /var/lib/nginx /var/lib/nginx
COPY --from=builder /bin/awk /bin/awk
COPY --from=builder /bin/sed /bin/sed
COPY --from=builder /bin/find /bin/find
COPY --from=builder /bin/envsubst /bin/envsubst
COPY --from=builder /docker-entrypoint.sh /docker-entrypoint.sh
COPY --from=builder /docker-entrypoint.d/ /docker-entrypoint.d/
COPY --from=builder /tmp/required-libs/ /usr/lib64/

# === Copy credentials ===
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group
COPY --from=builder /etc/shadow /etc/shadow

# === Ensure permissions ===
USER root
RUN chown -R nginx:nginx /var/log/nginx \
  && chown -R nginx:nginx /var/cache/nginx \
  && chown -R nginx:nginx /var/lib/nginx \
  && chmod -R +x /docker-entrypoint.d/*

USER nginx

EXPOSE 8080 8443

ENTRYPOINT ["/docker-entrypoint.sh"]

STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
